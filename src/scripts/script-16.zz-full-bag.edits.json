{"sourceBlobSha1":"cc5e0c7a64aacb86ed98737fdc4e9fba9d7f2907","description":"Issue #12: full bag by default, explicit all-items filter, reset on reopen. Shared hero/dungeon decoration only; equip, comparison, ownership and save rules unchanged.","edits":[{"name":"Reset the filter when reopening the same equipment window","old":"if(d._gearRoot===root){document.documentElement.classList.add('az-gear-lock');return;}","new":"if(d._gearRoot===root){document.documentElement.classList.add('az-gear-lock');d._gearShowAll?.();return;}"},{"name":"Default to the entire bag","old":"let slot='chest';","new":"let slot='all';"},{"name":"Describe the unfiltered bag","old":"worn.textContent='Надето: '+(equipped?equipped.getAttribute('aria-label').split(': ').slice(1).join(': '):'пусто');","new":"worn.textContent=slot==='all'?'Сумка: все предметы':'Надето: '+(equipped?equipped.getAttribute('aria-label').split(': ').slice(1).join(': '):'пусто');"},{"name":"Hide by slot only when a slot is explicitly selected","old":"b.parentElement.hidden=b.disabled||b.dataset.gearSlot!==slot;","new":"b.parentElement.hidden=b.disabled||(slot!=='all'&&b.dataset.gearSlot!==slot);"},{"name":"Preserve selection when viewing all slots","old":"if(force||selected?.dataset.gearSlot!==slot){","new":"if(force||!selected||(slot!=='all'&&selected.dataset.gearSlot!==slot)){"},{"name":"Select from all bag items in unfiltered mode","old":"const first=bag.find(b=>!b.disabled&&b.dataset.gearSlot===slot)||equipped;","new":"const first=bag.find(b=>!b.disabled&&(slot==='all'||b.dataset.gearSlot===slot))||equipped;"},{"name":"Distinguish an empty bag from an empty slot","old":"if(footer)footer.textContent='В этом слоте пока нет предметов.';","new":"if(footer)footer.textContent=slot==='all'?'В сумке пока нет предметов.':'В этом слоте пока нет предметов.';"},{"name":"Add an explicit all-items filter","old":"for(const [key,label]of [['head','Голова'],","new":"for(const [key,label]of [['all','Все предметы'],['head','Голова'],"},{"name":"Give all-items control its own row","old":"b.textContent=label;b.onclick=()=>{slot=key;apply(true);};","new":"b.textContent=label;if(key==='all')b.style.gridColumn='1 / -1';b.onclick=()=>{slot=key;apply(true);};"},{"name":"Expose a reset without duplicating navigation","old":"d._gearObserver=new MutationObserver(()=>apply());","new":"d._gearShowAll=()=>{slot='all';apply(true);};d._gearObserver=new MutationObserver(()=>apply());"}]}
