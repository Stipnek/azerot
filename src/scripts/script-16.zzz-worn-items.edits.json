  {
   "name": "All items view: list what is worn (bug hunt 1.3: the worn section is hidden in this window)",
   "old": "const equipped=Array.from(root.querySelectorAll('.az573-equip .az573-cell')).find(b=>b.dataset.gearSlot===slot&&!b.disabled);worn.textContent=slot==='all'?'Сумка: все предметы':",
   "new": "const wornAll=Array.from(root.querySelectorAll('.az573-equip .az573-cell')).filter(b=>!b.disabled),equipped=wornAll.find(b=>b.dataset.gearSlot===slot);worn.textContent=slot==='all'?'Надето: '+(wornAll.length?wornAll.map(b=>b.getAttribute('aria-label').split(': ').slice(1).join(': ')).join(' · '):'ничего'):"
  },
  {
   "name": "All items view with an empty bag: open the first worn item instead of \"no items\"",
