{"sourceSha256":"d6b8884a64eac761cbb061e28a3cfe001324a01b19917a813ae6bb6c1a0879c3","description":"Issue #12: quest-only compact, collapsed item receipts and viewport-bounded wrapper. Full battle item cards, grants and save logic unchanged.","edits":[{"name":"Support quest-only compact receipts","old":"  function azItemReceiptHtml(item,count) {","new":"  function azItemReceiptHtml(item,count,compact=false) {"},{"name":"Keep details collapsed until the item is expanded","old":"    const detail=[material,item.label,item.requiredLevel?'Требуется уровень '+item.requiredLevel:''].filter(Boolean).join(' · ');","new":"    const detail=[material,item.label,item.requiredLevel?'Требуется уровень '+item.requiredLevel:''].filter(Boolean).join(' · ');\n    if(compact) return `<details class='az-quest-item-compact' style='display:block;min-width:0;margin:8px 0;padding:8px;background:#191c20;border:1px solid #635b4b;border-radius:7px;text-align:left;color:#f5ead4;box-sizing:border-box'><summary style='display:grid;grid-template-columns:44px minmax(0,1fr);gap:8px;align-items:center;cursor:pointer;min-height:44px;list-style:none'><span style='position:relative;display:grid;place-items:center;width:44px;height:44px;box-sizing:border-box;border:2px solid ${color};border-radius:5px;background:#101215'>${image}<small style='position:absolute;right:1px;bottom:0;background:#101215;color:#fff;padding:0 2px'>×${esc(String(count))}</small></span><span style='min-width:0'><strong style='display:block;color:${color};font-size:14px;line-height:1.35;white-space:normal;word-break:normal;overflow-wrap:break-word'>${esc(item.name)}</strong><small style='display:block;color:#ded4c0'>Подробнее</small></span></summary><div class='az-quest-item-details' style='margin-top:8px;line-height:1.4;overflow-wrap:break-word'>${esc(detail)}<br>${esc(stats.join(' · '))}</div></details>`;"},{"name":"Use compact mode only for quest notifications","old":"      return '<li style=list-style:none;padding:0>' + azItemReceiptHtml(item, entry.count) + '</li>';","new":"      return '<li style=list-style:none;padding:0>' + azItemReceiptHtml(item, entry.count, true) + '</li>';"},{"name":"Give quest receipts readable width without list indentation","old":"    return '<div class=\"box\" aria-label=\"Полученные предметы\"><b>Получено в сумку</b><ul>' + receipt.map(function (entry) {","new":"    return '<div class=\"box az-quest-receipt\" style=\"width:min(360px,calc(100vw - 48px));box-sizing:border-box;max-width:none;text-align:left\" aria-label=\"Полученные предметы\"><b>Получено в сумку</b><ul style=\"padding:0;margin:8px 0 0;list-style:none\">' + receipt.map(function (entry) {"}]}
